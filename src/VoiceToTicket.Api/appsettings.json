{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Stt": {
    "BaseUrl": "http://stt:8000",
    "Languages": {
      "en": { "Model": "Systran/faster-whisper-medium.en", "TimeoutSeconds": 120 },
      "uk": { "Model": "Systran/faster-whisper-large-v3", "TimeoutSeconds": 300 }
    }
  },
  "TicketGenerator": {
    "Provider": "Fake"
  },
  "Translation": {
    "Provider": "Fake",
    "Model": "claude-haiku-5-5",
    "Effort": "low",
    "MaxTokens": 16000,
    "TimeoutSeconds": 60
  },
  "Jira": {
    "Enabled": false,
    "Deployment": "Cloud",
    "ServerAuthScheme": "Bearer",
    "DefaultLinkType": "Relates",
    "TimeoutSeconds": 15,
    "SessionHours": 8
  },
  "Claude": {
    "Model": "claude-sonnet-5-5",
    "Effort": "medium",
    "MaxTokens": 16000,
    "TimeoutSeconds": 60
  }
}

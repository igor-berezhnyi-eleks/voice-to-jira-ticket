{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Stt": {
    "BaseUrl": "http://stt:8000",
    "Model": "Systran/faster-whisper-medium.en",
    "Language": "en",
    "TimeoutSeconds": 120
  },
  "TicketGenerator": {
    "Provider": "Fake"
  },
  "Claude": {
    "Model": "claude-sonnet-5-5",
    "Effort": "medium",
    "MaxTokens": 16000,
    "TimeoutSeconds": 60
  }
}

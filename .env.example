# Copy to .env (git-ignored) and fill in. The app also starts without a .env file, using the fake generator.

# Fake or Claude. Anything else stops the app at startup.
TicketGenerator__Provider=Fake

# Needed only with TicketGenerator__Provider=Claude. Never commit a real key.
Claude__ApiKey=your-anthropic-api-key

# Optional (defaults in appsettings.json): Claude__Model=claude-sonnet-5-5, Claude__Effort=medium (low|medium|high|xhigh|max),
# Claude__MaxTokens=16000, Claude__TimeoutSeconds=60, Stt__TimeoutSeconds=120.
